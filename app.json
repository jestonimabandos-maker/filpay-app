{
  "expo": {
    "name": "FilPay",
    "slug": "filpay-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F8F4",
    "scheme": "filpay",
    "primaryColor": "#0F6B3A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.filpay.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "FilPay"
      }
    },
    "android": {
      "package": "com.filpay.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#EFE7F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "FilPay uses the camera to scan merchant QR codes for payments."
        }
      ],
      "expo-sqlite"
    ]
  }
}
